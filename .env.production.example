# =============================================================================
#  Muhame Site: PRODUCTION environment template
# -----------------------------------------------------------------------------
#  1. Copy this file to the server as `.env` (never commit the real .env).
#  2. Replace every value marked  CHANGE_ME.
#  3. Run `php artisan key:generate --force` once to fill APP_KEY, then
#     never change APP_KEY again (it would log everyone out and break
#     encrypted data).
#  4. After any change to .env, run `php artisan optimize` to refresh the cache.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Muhame"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Full public address of the site, with https:// and no trailing slash.
APP_URL=https://CHANGE_ME.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Keep false in production: admin accounts are created with
# `php artisan cms:create-admin`, not by public sign-up.
CMS_ALLOW_REGISTRATION=false

# --- Logging -----------------------------------------------------------------
# One log file per day in storage/logs, kept for 14 days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL / MariaDB) ----------------------------------------------
# Use a dedicated database user with access to this database only, never root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_database_name
DB_USERNAME=CHANGE_ME_database_user
DB_PASSWORD=CHANGE_ME_strong_database_password

# --- Sessions ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave as null unless the site is shared across subdomains (then: .your-domain.com).
SESSION_DOMAIN=null
# Cookies only over HTTPS. Requires the site to be served on https://.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache, queue, broadcasting & files --------------------------------------
CACHE_STORE=database
CACHE_PREFIX=muhame_cache_

# Contact-form emails are queued: a worker must run `php artisan queue:work`.
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

# Uploaded images use the "public" disk; run `php artisan storage:link` once.
FILESYSTEM_DISK=local

# --- Mail (SMTP) -------------------------------------------------------------
# Get these from your email provider (e.g. your host's SMTP, Mailgun, Brevo,
# Postmark, Amazon SES, Google Workspace). Port 587 + MAIL_SCHEME=null uses
# STARTTLS. For port 465, set MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME.smtp-host.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_smtp_username
MAIL_PASSWORD=CHANGE_ME_smtp_password
# Must be an address your mail provider allows you to send from.
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Optional: Redis (only if your server has it) ----------------------------
# To use Redis, set CACHE_STORE=redis, QUEUE_CONNECTION=redis and
# SESSION_DRIVER=redis above.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Optional: Amazon S3 (only if storing uploads on S3) ---------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Front-end ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
